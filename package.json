{
  "name": "flwn-oqelira",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test -w @oqelira/core -w @oqelira/engine -w @oqelira/cli -w @oqelira/host -w @oqelira/server -w @oqelira/worker -w oqelira-vscode",
    "live": "npm run live -w @oqelira/core",
    "oqelira": "node packages/cli/bin/oqelira.mjs",
    "desktop": "npm run start -w @oqelira/desktop",
    "build": "npm run build -w @oqelira/web && npm run build -w oqelira-vscode",
    "setup:server": "node --import tsx scripts/setup-server.ts",
    "security:staged": "node --import tsx scripts/check-staged-secrets.ts",
    "server": "node --env-file=.env.server --import tsx packages/server/src/main.ts",
    "db:migrate": "node --env-file=.env.server --import tsx packages/server/src/migrate.ts",
    "db:start": "docker compose --env-file .env.server -f deploy/compose.dev.yml up -d db",
    "sandbox": "node --env-file=.env.server --import tsx packages/server/src/runner.ts",
    "worker:build": "docker build -t oqelira-worker:local -f packages/worker/Dockerfile .",
    "foundry:check": "node --import tsx packages/core/scripts/check-connection.ts",
    "extension:build": "npm run build -w oqelira-vscode",
    "extension:package": "npm run package -w oqelira-vscode"
  }
}
