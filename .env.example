# Copy to ~/.oqelira/.env (or pass --env-file). A project's own ./.env may only choose deployments
# (OQELIRA_MODEL, OQELIRA_MODELS_JSON, OQELIRA_EMBEDDING_DEPLOYMENT, FOUNDRY_MODELS, FOUNDRY_VARIANTS);
# keys and endpoints in it are ignored.
# Same values as flwn-ai/.env.
# Just the resource name (the first part of the host), e.g. aif-flwn-fc-01
FOUNDRY_RESOURCE=
FOUNDRY_KEY=
# Used by `npm run spike`. Host as shown in the portal, no path after azure.com
FOUNDRY_ENDPOINT=https://<resource>.openai.azure.com
# Deployment names, comma separated
FOUNDRY_MODELS=MAI-Thinking-1,gpt-6-sol,gpt-6-luna
# Optional: full base URL override for a different route (beats FOUNDRY_ENDPOINT)
# FOUNDRY_BASE_URL=https://<resource>.services.ai.azure.com/openai/v1
# Which ways to call each model: chat | chat-none | responses  (comma separated)
#  - chat       : plain /chat/completions
#  - chat-none  : /chat/completions with reasoning_effort=none (fixes gpt-6-* tool calls, no reasoning)
#  - responses  : /responses API (tools + reasoning together)
FOUNDRY_VARIANTS=chat
# Optional: only for `npm run prompt:eval`. Comma-separated model ids to compare (default: all).
# PROMPT_EVAL_MODELS=gpt-6-sol

# Web/Desktop local host (optional). Workspace is fixed at host startup.
# OQELIRA_WORKSPACE=C:\path\to\your\project
# Override the default registry with actual Foundry deployment names:
# OQELIRA_MODELS_JSON=[{"id":"my-model","deployment":"my-deployment","api":"responses","speed":"fast"}]

# Optional account email delivery. Production requires verified email and a sender.
# SMTP uses SMTPS or required STARTTLS; keep credentials only in private .env.server.
# OQELIRA_REQUIRE_VERIFIED_EMAIL=true
# OQELIRA_SMTP_URL=smtps://username:password@smtp.example.com:465
# OQELIRA_SMTP_FROM=accounts@example.com
# Optional Web identity providers; register callback /api/auth/callback/google or github.
# OQELIRA_GOOGLE_CLIENT_ID=
# OQELIRA_GOOGLE_CLIENT_SECRET=
# OQELIRA_GITHUB_CLIENT_ID=
# OQELIRA_GITHUB_CLIENT_SECRET=

# Optional: enables the web_search tool in CLI, Web/Desktop host and VS Code (not the sandboxed server).
# TAVILY_API_KEY=

# Optional: Foundry embedding deployment name. Enables project memory (recall across chats) in the CLI.
# Stored locally in ~/.oqelira/projects/<hash>/memory.sqlite (outside the repo).
# OQELIRA_EMBEDDING_DEPLOYMENT=

# Optional local token limits. Both input and output tokens count in rolling windows.
# OQELIRA_USAGE_5H_TOKENS=100000
# OQELIRA_USAGE_WEEKLY_TOKENS=1000000

# Optional auto-mode classifier (Microsoft Decision-1 System One endpoint).
# FOUNDRY_DECISION_ENDPOINT=https://<resource>.services.ai.azure.com/providers/microsoft
# FOUNDRY_DECISION_DEPLOYMENT=Decision-1
# FOUNDRY_DECISION_ALLOW_THRESHOLD=0.95
# Then run: npm run classifier:eval

# Cloud model gateway service (packages/gateway, run with `npm run gateway`). It reads FOUNDRY_* and
# OQELIRA_MODELS_JSON from its own file, .env.gateway (ignored). Nothing from a project's .env applies.
# Token signing key, at least 32 random bytes. Rotating it signs every user out.
# OQELIRA_GATEWAY_TOKEN_KEY=
# OQELIRA_GATEWAY_DATABASE_URL=postgres://...?sslmode=verify-full
# Required: every model in the registry needs a price, in USD per million tokens.
# OQELIRA_GATEWAY_PRICES_JSON={"gpt-6-sol":{"inputUsdPerMTok":0,"outputUsdPerMTok":0}}
# Required spend ceilings per user and per organization over a rolling week.
# OQELIRA_GATEWAY_USER_WEEKLY_USD=
# OQELIRA_GATEWAY_ORG_WEEKLY_USD=
# Optional token windows (input + output, rolling) and requests per minute per user (default 30).
# OQELIRA_GATEWAY_5H_TOKENS=
# OQELIRA_GATEWAY_WEEKLY_TOKENS=
# OQELIRA_GATEWAY_RPM=30

# Gateway mode (client side): when both are set, every model call goes through the gateway with this short-lived
# user token, and no FOUNDRY_* value is read. Put them in ~/.oqelira/.env or the environment; a project's .env
# cannot set them. In VS Code use "Oqelira: Configure Gateway" (SecretStorage). Unset = direct Foundry mode.
# OQELIRA_GATEWAY_URL=https://gateway.example.com
# OQELIRA_GATEWAY_TOKEN=
