{
  "name": "@oqelira/engine",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Headless Oqelira agent engine. No terminal UI: the web host and VS Code depend on this.",
  "exports": { ".": "./src/index.ts", "./client": "./src/client.ts", "./package.json": "./package.json" },
  "bin": { "oqelira-engine": "bin/oqelira-engine.mjs" },
  "scripts": {
    "start": "node bin/oqelira-engine.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@oqelira/core": "*",
    "@oqelira/protocol": "*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
