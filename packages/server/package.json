{
  "name": "@oqelira/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --import tsx src/main.ts",
    "runner": "node --import tsx src/runner.ts",
    "migrate": "node --import tsx src/migrate.ts",
